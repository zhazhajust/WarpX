max_step = 384
amr.n_cell = 8 8 96
amr.max_level = 0
geometry.dims = 3
geometry.prob_lo = -20.0e-6 -20.0e-6 -200.0e-6
geometry.prob_hi =  20.0e-6  20.0e-6  220.0e-6

my_constants.Bu = 1.0
my_constants.lambda_u = 100.0e-6
my_constants.k_u = 2.0*pi/lambda_u

algo.maxwell_solver = Yee
algo.particle_shape = 1

warpx.const_dt = 2.5e-15
warpx.random_seed = 42
warpx.serialize_initial_conditions = 1
warpx.reduced_diags_names = rad

boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic
boundary.particle_lo = periodic periodic periodic
boundary.particle_hi = periodic periodic periodic

particles.species_names = beam
particles.B_ext_particle_init_style = parse_B_ext_particle_function
particles.Bx_external_particle_function(x,y,z,t) = 0.0
particles.By_external_particle_function(x,y,z,t) = Bu*cos(k_u*z)
particles.Bz_external_particle_function(x,y,z,t) = 0.0

beam.charge = -q_e
beam.mass = m_e
beam.injection_style = SingleParticle
beam.single_particle_pos = 0.0 0.0 -120.0e-6
beam.single_particle_u = 0.0 0.0 1.0
beam.single_particle_weight = 1.0e7

rad.type = TimeDomainRadiation
rad.intervals = 384
rad.species = beam
rad.n_time = 400
rad.n_theta = 41
rad.n_phi = 1
rad.time_min = 1.5e-13
rad.time_max = 8.0e-13
rad.theta_min = 0.0
rad.theta_max = 1.2
rad.phi_min = 0.0
rad.phi_max = 0.0
rad.radius = 1.0
rad.far_field_approx = 1
